{
  "name": "@inspectstack/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env.local ../../node_modules/vitest/vitest.mjs run",
    "seed": "tsx --env-file=../../.env.local src/seed.ts",
    "reset": "tsx --env-file=../../.env.local src/seed.ts --reset",
    "migrate:week5": "tsx --env-file=../../.env.local src/migrate-week5.ts",
    "migrate:week6": "tsx --env-file=../../.env.local src/migrate-week6.ts",
    "migrate:week7": "tsx --env-file=../../.env.local src/migrate-week7.ts"
  },
  "dependencies": {
    "@inspectstack/config": "workspace:*",
    "@inspectstack/domain": "workspace:*",
    "@inspectstack/testkit": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "drizzle-kit": "catalog:",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
