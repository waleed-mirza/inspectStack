# InspectStack sample environment.
# Copy this file to `.env.local` at the repo root (gitignored). Then run `pnpm env:sync`.
# Do not put production keys here. Do not commit real keys.
#
# Values come from a Supabase project:
#   npx supabase projects api-keys --project-ref YOUR_PROJECT_REF --reveal
#
# Create your own Supabase project (dev). A separate prod project is optional for launch.

# --- App ---
# Public origin of this Next app (magic-link and invite redirects).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Auth + API (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Placeholders must be ≥20 characters so `readPublicEnv` accepts a fresh-clone build.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_REPLACE_ME
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_REPLACE_ME

# --- Database ---
# Direct db.<ref>.supabase.co is IPv6-only on some networks. Session pooler is the
# documented path. packages/db rewrites IPv6-only hosts automatically when needed.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
# Optional override if the pooler host is not ap-southeast-1:
# SUPABASE_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com

# --- Seed ---
# Password assigned to seeded demo personas. Use this value to sign in after `pnpm db:reset`.
SEED_PASSWORD=your-seed-password

# --- Jobs ---
# HTTP job worker. POST /api/jobs/run with Authorization: Bearer CRON_SECRET
# Optional in local demo — the schedules page has Run due jobs.
CRON_SECRET=change-me-in-dev
